# Copy to .env and fill in. Never commit .env.

# Anthropic API key from a dedicated Console workspace with a $10/month spend limit.
ANTHROPIC_API_KEY=

# TypeSafe API key for Jev, the second-opinion verifier (console.typesafe.ai). Prepaid balance.
TYPESAFE_API_KEY=

# Optional: override the model used for every agent step (default: claude-haiku-4-5).
# The model must have an entry in agent/config.py PRICES so every run's cost is logged.
# AGENT_MODEL=claude-haiku-4-5

# Supabase (Project Settings > API Keys). The secret key bypasses row-level security: it is for
# the Curator and server functions only and must never reach the browser. The publishable key is
# safe in the browser; it can only read published items (see supabase/schema.sql).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
