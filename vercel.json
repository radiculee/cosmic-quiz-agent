{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "regions": ["dub1"],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "cosmic.vedantgaikwad.ie" }],
      "destination": "https://curiosity.vedantgaikwad.ie/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "quiz.vedantgaikwad.ie" }],
      "destination": "https://curiosity.vedantgaikwad.ie/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "astro.vedantgaikwad.ie" }],
      "destination": "https://curiosity.vedantgaikwad.ie/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "cosmik.vedantgaikwad.ie" }],
      "destination": "https://curiosity.vedantgaikwad.ie/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "curiousity.vedantgaikwad.ie" }],
      "destination": "https://curiosity.vedantgaikwad.ie/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "curiosty.vedantgaikwad.ie" }],
      "destination": "https://curiosity.vedantgaikwad.ie/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "cosmicquiz.vedantgaikwad.ie" }],
      "destination": "https://curiosity.vedantgaikwad.ie/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "cosmic-quiz-agent.vercel.app" }],
      "destination": "https://curiosity.vedantgaikwad.ie/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/media/:path(.*)",
      "destination": "https://fbwezifjjmmczevgpfiw.supabase.co/storage/v1/object/public/topic-images/:path"
    },
    { "source": "/((?!api/).*)", "destination": "/spa.html" }
  ],
  "headers": [
    {
      "source": "/scenes/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self' https://fbwezifjjmmczevgpfiw.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{node_modules/**,dist/**,src/**,tests/**,evals/**,curator/**,dev/**,docs/**,supabase/**,runs/**,.github/**}"
    }
  }
}
