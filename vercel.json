{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "regions": ["dub1"],
  "functions": {
    "api/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{node_modules/**,dist/**,src/**,tests/**,evals/**,curator/**,dev/**,docs/**,supabase/**,runs/**,.github/**}"
    }
  }
}
